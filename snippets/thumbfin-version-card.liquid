{%- comment -%}
  Thumb Fin redesign: one version of the Thumb Fin (e.g. Original, Low Profile) with
  colour swatches and an Add to cart button that goes through Dawn's <product-form>.

  A version is either
  - one product whose variants are the colours (e.g. LOW PROFILE Thumb Fin), or
  - a list of single-variant products, one per colour (e.g. Thumb Fin (Black),
    Thumb Fin (Neon), ...). Each swatch then adds that colour's product.

  Accepts:
  - block: {block} the "version" block (settings: title, description, product, products, image)
  - swatch_lines: {array} "Name: #hex" lines
  - add_label: {string}
  - learn_label: {string} text of the link to the product page (default 'Learn more');
    the link, photo and name follow the selected colour
{%- endcomment -%}
{%- liquid
  assign product = block.settings.product
  assign product_list = block.settings.products
  assign use_list = false
  if product_list.size > 0
    assign use_list = true
    assign product = product_list.first
    for p in product_list
      if p.available
        assign product = p
        break
      endif
    endfor
  endif
  assign current = product.selected_or_first_available_variant

  assign option_name = product.options.first | downcase
  assign use_swatches = false
  if use_list
    assign use_swatches = true
  elsif product.options.size == 1 and product.has_only_default_variant == false
    if option_name == 'color' or option_name == 'colour' or option_name == 'colors' or option_name == 'colours'
      assign use_swatches = true
    endif
  endif

  assign title = block.settings.title | default: product.title
  if use_list
    assign current_url = product.url
  else
    assign current_url = current.url
  endif
  assign current_image = current.featured_media.preview_image | default: product.featured_media.preview_image
  if block.settings.image != blank
    assign current_image = block.settings.image
  endif
-%}
{%- if product != blank -%}
<thumbfin-spotlight class="tfr-version-card" {{ block.shopify_attributes }}>
  <a class="tfr-version-media" href="{{ current_url }}" data-tfr-product-link tabindex="-1" aria-hidden="true">
    {%- if current_image != blank -%}
      {{ current_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 700', sizes: '(max-width: 820px) 90vw, 340px', alt: '', class: 'tfr-spot-img' }}
    {%- else -%}
      <div class="tfr-fin-disc"><div class="tfr-fin-stem"></div></div>
    {%- endif -%}
  </a>
  <h3><a class="tfr-card-link" href="{{ current_url }}" data-tfr-product-link>{{ title | escape }}</a></h3>
  <div class="tfr-price-row">
    <span class="tfr-price" data-tfr-price>{{ current.price | money_without_trailing_zeros }}</span>
    <s class="tfr-compare" data-tfr-compare>{% if current.compare_at_price > current.price %}{{ current.compare_at_price | money_without_trailing_zeros }}{% endif %}</s>
  </div>
  {%- if block.settings.description != blank -%}
    <p class="tfr-desc">{{ block.settings.description | escape }}</p>
  {%- endif -%}

  <product-form class="tfr-product-form" data-hide-errors="false">
  {%- form 'product', product, novalidate: 'novalidate' -%}
    {%- if use_swatches or product.has_only_default_variant -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-tfr-variant-id>
    {%- endif -%}

    {%- if use_swatches -%}
      {%- capture current_label -%}
        {%- if use_list -%}
          {%- capture found -%}{%- render 'thumbfin-swatch-color', name: product.title, lines: swatch_lines -%}{%- endcapture -%}
          {%- assign found_parts = found | split: '|' -%}
          {{- found_parts[0] | default: product.title -}}
        {%- else -%}
          {{- current.title -}}
        {%- endif -%}
      {%- endcapture -%}
      <fieldset class="tfr-swatches">
        <legend class="tfr-option-label">Color: <span data-tfr-variant-title>{{ current_label | escape }}</span></legend>
        <div class="tfr-swatch-row">
          {%- if use_list -%}
            {%- for p in product_list -%}
              {%- liquid
                assign v = p.selected_or_first_available_variant
                capture found
                  render 'thumbfin-swatch-color', name: p.title, lines: swatch_lines
                endcapture
                assign found_parts = found | split: '|'
                assign swatch_name = found_parts[0] | default: p.title
                assign swatch_hex = found_parts[1]
                assign swatch_image = v.featured_media.preview_image | default: p.featured_media.preview_image
              -%}
              <input
                type="radio" class="tfr-visually-hidden"
                id="tfr-{{ block.id }}-{{ v.id }}" name="tfr-{{ block.id }}" value="{{ v.id }}"
                data-tfr-variant-input
                {% if v.id == current.id %}checked{% endif %}
                {% unless p.available %}disabled{% endunless %}
                data-price="{{ v.price | money_without_trailing_zeros | escape }}"
                data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money_without_trailing_zeros | escape }}{% endif %}"
                data-available="{{ p.available }}"
                data-title="{{ swatch_name | escape }}"
                data-url="{{ p.url }}"
                data-image="{% if swatch_image %}{{ swatch_image | image_url: width: 700 }}{% endif %}"
              >
              <label for="tfr-{{ block.id }}-{{ v.id }}" class="tfr-swatch" title="{{ swatch_name | escape }}"{% if swatch_hex != blank %} style="--tfr-swatch: {{ swatch_hex }};"{% endif %}>
                <span class="tfr-visually-hidden">{{ swatch_name | escape }}{% unless p.available %} (sold out){% endunless %}</span>
              </label>
            {%- endfor -%}
          {%- else -%}
            {%- for v in product.variants -%}
              {%- liquid
                capture found
                  render 'thumbfin-swatch-color', name: v.option1, lines: swatch_lines
                endcapture
                assign found_parts = found | split: '|'
                assign swatch_hex = found_parts[1]
                assign swatch_image = v.featured_media.preview_image | default: product.featured_media.preview_image
              -%}
              <input
                type="radio" class="tfr-visually-hidden"
                id="tfr-{{ block.id }}-{{ v.id }}" name="tfr-{{ block.id }}" value="{{ v.id }}"
                data-tfr-variant-input
                {% if v.id == current.id %}checked{% endif %}
                {% unless v.available %}disabled{% endunless %}
                data-price="{{ v.price | money_without_trailing_zeros | escape }}"
                data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money_without_trailing_zeros | escape }}{% endif %}"
                data-available="{{ v.available }}"
                data-title="{{ v.title | escape }}"
                data-url="{{ v.url }}"
                data-image="{% if swatch_image %}{{ swatch_image | image_url: width: 700 }}{% endif %}"
              >
              <label for="tfr-{{ block.id }}-{{ v.id }}" class="tfr-swatch" title="{{ v.title | escape }}"{% if swatch_hex != blank %} style="--tfr-swatch: {{ swatch_hex }};"{% endif %}>
                <span class="tfr-visually-hidden">{{ v.title | escape }}{% unless v.available %} (sold out){% endunless %}</span>
              </label>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </fieldset>
    {%- elsif product.has_only_default_variant == false -%}
      <label class="tfr-option-label" for="tfr-{{ block.id }}-variant">{{ product.options | join: ' / ' | escape }}</label>
      <select class="tfr-select" id="tfr-{{ block.id }}-variant" name="id" data-tfr-variant-input>
        {%- for v in product.variants -%}
          <option value="{{ v.id }}" {% if v.id == current.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}
            data-price="{{ v.price | money_without_trailing_zeros | escape }}" data-available="{{ v.available }}" data-title="{{ v.title | escape }}" data-url="{{ v.url }}">
            {{- v.title | escape }}{% unless v.available %} (sold out){% endunless -%}
          </option>
        {%- endfor -%}
      </select>
    {%- endif -%}

    <button
      type="submit" name="add" class="tfr-btn tfr-btn--primary" data-tfr-submit
      data-label-add="{{ add_label | default: 'Add to cart' | escape }}" data-label-sold-out="Sold out"
      {% unless current.available %}disabled{% endunless %}
    >
      <span data-tfr-submit-label>
        {%- if current.available -%}{{ add_label | default: 'Add to cart' | escape }}{%- else -%}Sold out{%- endif -%}
      </span>
      {%- render 'loading-spinner' -%}
    </button>
    <div class="product-form__error-message-wrapper tfr-form-error" role="alert" hidden>
      <span class="product-form__error-message"></span>
    </div>
  {%- endform -%}
  </product-form>
  <a class="tfr-learn-more" href="{{ current_url }}" data-tfr-product-link>
    {{- learn_label | default: 'Learn more' | escape }}<span class="tfr-visually-hidden"> about {{ title | escape }}</span> <span aria-hidden="true">→</span>
  </a>
</thumbfin-spotlight>
{%- endif -%}
