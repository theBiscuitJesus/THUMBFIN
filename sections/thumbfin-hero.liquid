{%- comment -%}
  Thumb Fin redesign: homepage hero (rating badge, pain-point headline, two buttons).
  Styles in assets/thumbfin.css.
{%- endcomment -%}
{{ 'thumbfin.css' | asset_url | stylesheet_tag }}

<div class="tfr">
  <section class="tfr-hero">
    <div class="tfr-wrap tfr-hero-grid">
      <div>
        {%- liquid
          # Live store-wide numbers from Judge.me (updated by the app as reviews come in);
          # the typed Rating / Review count are the fallback.
          assign rating = section.settings.rating
          assign rating_count = section.settings.rating_count
          if section.settings.live_rating
            assign jm_rating = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
            assign jm_count = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count
            if jm_rating != blank and jm_count != blank and jm_count != '0'
              assign rating = jm_rating | times: 1.0 | round: 2
              assign rating_count = jm_count
            endif
          endif
        -%}
        {%- if rating != blank -%}
          <p class="tfr-badge">
            <span aria-hidden="true">★</span>
            <b>{{ rating | escape }}</b>
            {%- if rating_count != blank %} from {{ rating_count | escape }} {{ section.settings.rating_suffix | escape }}{% endif -%}
            {%- if section.settings.badge_extra != blank %} · {{ section.settings.badge_extra | escape }}{% endif -%}
          </p>
        {%- endif -%}
        <h1>
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_line_2 != blank %} <br>{{ section.settings.heading_line_2 | escape }}{%- endif -%}
        </h1>
        {%- if section.settings.text != blank -%}
          <p class="tfr-hero-sub">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        <div class="tfr-cta-row">
          <a class="tfr-btn tfr-btn--primary" href="#thumbfin-shop">
            {{- section.settings.button_label | escape -}}
            {%- if section.settings.price_product != blank %} — {{ section.settings.price_product.price | money_without_trailing_zeros }}{% endif -%}
          </a>
          {%- if section.settings.secondary_label != blank -%}
            <a class="tfr-btn tfr-btn--ghost" href="#thumbfin-video">{{ section.settings.secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
      <div class="tfr-hero-art">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 750, 1000', sizes: '(max-width: 820px) 90vw, 480px' }}
        {%- else -%}
          <div class="tfr-fin-disc" aria-hidden="true"><div class="tfr-fin-stem"></div></div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Thumb Fin hero",
  "tag": "div",
  "class": "section-thumbfin-hero",
  "settings": [
    { "type": "checkbox", "id": "live_rating", "label": "Use live Judge.me rating and review count", "info": "Falls back to the numbers below if Judge.me has none.", "default": true },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.84" },
    { "type": "text", "id": "rating_count", "label": "Review count", "default": "145" },
    { "type": "text", "id": "rating_suffix", "label": "Text after the count", "default": "reviews" },
    { "type": "text", "id": "badge_extra", "label": "Extra badge text", "default": "Patented design" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop drilling holes" },
    { "type": "text", "id": "heading_line_2", "label": "Heading, second line", "default": "in your bass." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thumb Fin is a suction-cup thumb rest you can place anywhere, move anytime, and remove without a trace. No screws, no adhesive, no regrets." },
    { "type": "text", "id": "button_label", "label": "Main button label", "default": "Shop Thumb Fin" },
    { "type": "product", "id": "price_product", "label": "Show price of", "info": "Adds \"— $20\" to the main button. Leave empty to hide the price." },
    { "type": "text", "id": "secondary_label", "label": "Video button label", "default": "Watch it in action" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Thumb Fin hero" }]
}
{% endschema %}
