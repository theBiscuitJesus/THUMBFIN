{%- comment -%}
  Thumb Fin email signup popup: "10% off your first order". Lives in the footer group so it
  loads on every page; skipped on the cart and account pages and for customers who are
  already subscribed.

  Signs people up with Shopify's own customer form (tagged "newsletter"), so they join the
  same list Shopify Email sends to. After submitting, the page reloads and the popup reopens
  showing the discount code.

  Add ?signup-preview to any URL to see the popup even while it's switched off.
{%- endcomment -%}

{%- liquid
  assign skip = false
  if template.name == 'cart' or template.name == 'password' or template.directory == 'customers'
    assign skip = true
  endif
  if customer and customer.accepts_marketing
    assign skip = true
  endif
  assign code = section.settings.code | strip | upcase
-%}

{%- unless skip -%}
  {{ 'thumbfin.css' | asset_url | stylesheet_tag }}

  <thumbfin-signup
    class="tfr tfr-signup"
    hidden
    data-enabled="{{ section.settings.enabled }}"
    data-delay="{{ section.settings.delay }}"
    data-exit-intent="{{ section.settings.exit_intent }}"
    data-days="{{ section.settings.days }}"
  >
    <div class="tfr-signup-backdrop" data-signup-close></div>
    <div
      class="tfr-signup-card{% if section.settings.show_image %} tfr-signup-card--image{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="TfrSignupTitle-{{ section.id }}"
      tabindex="-1"
    >
      <button type="button" class="tfr-signup-close" data-signup-close aria-label="Close">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>

      {%- if section.settings.show_image -%}
        <div class="tfr-signup-media">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 700px) 340px, 100vw', widths: '400, 600, 900', alt: section.settings.image.alt | default: 'Thumb Fin on a bass' }}
          {%- else -%}
            <img src="{{ 'IMG_0004.jpg' | file_url }}&width=900" alt="Thumb Fin on a bass" loading="lazy" width="900" height="675">
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="tfr-signup-body">
        {%- form 'customer', id: 'TfrSignup', class: 'tfr-signup-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="tfr-signup-eyebrow">{{ section.settings.eyebrow | escape }}</p>
            <h2 id="TfrSignupTitle-{{ section.id }}">{{ section.settings.success_heading | escape }}</h2>
            <p class="tfr-signup-text">{{ section.settings.success_text | escape }}</p>
            {%- if code != blank -%}
              <div class="tfr-signup-code">
                <span>Your code</span>
                <strong>{{ code | escape }}</strong>
              </div>
              <a class="tfr-btn tfr-btn--primary tfr-signup-submit" href="{{ routes.root_url | append: 'discount/' | append: code | append: '?redirect=/#thumbfin-shop' }}" data-signup-done>
                {{- section.settings.shop_label | escape -}}
              </a>
              <p class="tfr-signup-fine">{{ section.settings.success_fine | escape }}</p>
            {%- endif -%}
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter,signup-popup">
            <p class="tfr-signup-eyebrow">{{ section.settings.eyebrow | escape }}</p>
            <h2 id="TfrSignupTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
            <p class="tfr-signup-text">{{ section.settings.text | escape }}</p>
            <label class="tfr-visually-hidden" for="TfrSignupEmail-{{ section.id }}">Email</label>
            <input
              id="TfrSignupEmail-{{ section.id }}"
              class="tfr-signup-input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="Email address"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="TfrSignupError-{{ section.id }}"{% endif %}
            >
            {%- if form.errors -%}
              <p class="tfr-form-error" id="TfrSignupError-{{ section.id }}">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}
            <button type="submit" class="tfr-btn tfr-btn--primary tfr-signup-submit">{{ section.settings.button_label | escape }}</button>
            <button type="button" class="tfr-signup-decline" data-signup-close>{{ section.settings.decline_label | escape }}</button>
            {%- if section.settings.fine_print != blank -%}
              <p class="tfr-signup-fine">{{ section.settings.fine_print | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </thumbfin-signup>

  <script src="{{ 'thumbfin.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{% schema %}
{
  "name": "Thumb Fin signup popup",
  "tag": "div",
  "class": "section-thumbfin-signup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show popup to visitors",
      "info": "Add ?signup-preview to any page URL to see it while this is off.",
      "default": false
    },
    {
      "type": "range",
      "id": "delay",
      "min": 3,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Show after",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "exit_intent",
      "label": "Also show when a desktop visitor moves to leave",
      "default": true
    },
    {
      "type": "range",
      "id": "days",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "d",
      "label": "After closing, hide for",
      "default": 14
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Defaults to the Thumb Fin on a bass photo."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Join the Thumb Fin list"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first Thumb Fin"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sign up for new colors, playing tips and subscriber-only deals."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my 10%"
    },
    {
      "type": "text",
      "id": "decline_label",
      "label": "Decline link",
      "default": "No thanks"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "One use per customer. Unsubscribe anytime."
    },
    {
      "type": "header",
      "content": "After signing up"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount code",
      "default": "WELCOME10"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Heading",
      "default": "You're in!"
    },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Text",
      "default": "Here's 10% off your first order."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Button label",
      "default": "Shop with 10% off"
    },
    {
      "type": "text",
      "id": "success_fine",
      "label": "Fine print",
      "default": "The button applies your code automatically. You can also enter it at checkout."
    }
  ],
  "presets": [
    {
      "name": "Thumb Fin signup popup"
    }
  ]
}
{% endschema %}
