{%- comment -%}
  Thumb Fin redesign on product pages, placed under the main product section:
  trust strip -> "complete your setup" offers (Combo 3-Pack with savings, contact
  paper) -> how it works -> demo video.

  Offers never show the product being viewed. On the combo or add-on page the single
  Thumb Fin is offered instead, when it's set under "Single Thumb Fin".
{%- endcomment -%}

{%- liquid
  assign combo = section.settings.combo_product
  if combo == blank
    assign combo = all_products['combo-3-pack-one-of-each-version']
  endif

  assign addon = section.settings.addon_product
  if addon == blank
    assign addon = all_products['contact-paper-for-matte-finish']
  endif

  assign on_combo = false
  assign on_addon = false
  if product.id == combo.id
    assign on_combo = true
  endif
  if product.id == addon.id
    assign on_addon = true
  endif

  assign single = section.settings.single_product
  if single == blank and on_combo == false and on_addon == false
    assign single = product
  endif

  assign singles_total = nil
  if single != blank
    assign singles_total = single.price | times: section.settings.combo_units
  endif

  assign show_single = false
  if single != blank and single.id != product.id
    assign show_single = true
  endif
  assign show_combo = false
  if combo.id != blank and on_combo == false
    assign show_combo = true
  endif
  assign show_addon = false
  if addon.id != blank and on_addon == false
    assign show_addon = true
  endif

  assign ticker_blocks = section.blocks | where: 'type', 'ticker'
  assign step_blocks = section.blocks | where: 'type', 'step'
-%}

{{ 'thumbfin.css' | asset_url | stylesheet_tag }}

<div class="tfr">
  {%- render 'thumbfin-ticker', blocks: ticker_blocks -%}

  {%- if show_single or show_combo or show_addon -%}
    <section class="tfr-section tfr-section--compact" id="thumbfin-offers">
      <div class="tfr-wrap">
        {%- if section.settings.offers_heading != blank or section.settings.offers_text != blank -%}
          <div class="tfr-section-head">
            {%- if section.settings.offers_heading != blank -%}<h2>{{ section.settings.offers_heading | escape }}</h2>{%- endif -%}
            {%- if section.settings.offers_text != blank -%}<p>{{ section.settings.offers_text | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
        <div class="tfr-bundle-row">
          {%- if show_single -%}
            {%- render 'thumbfin-offer-card',
              product: single,
              description: section.settings.single_desc,
              add_label: section.settings.add_label,
              uid: section.id
            -%}
          {%- endif -%}
          {%- if show_combo -%}
            {%- render 'thumbfin-offer-card',
              product: combo,
              featured: true,
              description: section.settings.combo_desc,
              singles_total: singles_total,
              units: section.settings.combo_units,
              save_label: section.settings.save_label,
              add_label: section.settings.add_label,
              uid: section.id,
              learn_label: section.settings.learn_label
            -%}
          {%- endif -%}
          {%- if show_addon -%}
            {%- render 'thumbfin-offer-card',
              product: addon,
              prefix: '+ ',
              description: section.settings.addon_desc,
              add_label: section.settings.add_label,
              uid: section.id,
              learn_label: section.settings.learn_label
            -%}
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- render 'thumbfin-steps', blocks: step_blocks, heading: section.settings.how_heading, text: section.settings.how_text, anchor: 'thumbfin-how' -%}

  {%- if section.settings.show_video -%}
    {%- render 'thumbfin-video',
      video: section.settings.video,
      poster: section.settings.video_poster,
      heading: section.settings.video_heading,
      text: section.settings.video_text,
      button_label: section.settings.video_button_label,
      anchor: 'thumbfin-video'
    -%}
  {%- endif -%}
</div>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'thumbfin.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Thumb Fin product extras",
  "tag": "div",
  "class": "section-thumbfin-product-extras",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "single_product",
      "label": "Single Thumb Fin",
      "info": "Used for the combo savings and offered on the combo / add-on pages. On a single's own page, that product is used automatically."
    },
    {
      "type": "product",
      "id": "combo_product",
      "label": "Combo pack",
      "info": "Falls back to the product with handle combo-3-pack-one-of-each-version."
    },
    {
      "type": "range",
      "id": "combo_units",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Singles included in combo"
    },
    {
      "type": "product",
      "id": "addon_product",
      "label": "Add-on (contact paper)",
      "info": "Falls back to the product with handle contact-paper-for-matte-finish."
    },
    {
      "type": "header",
      "content": "Offers"
    },
    {
      "type": "text",
      "id": "offers_heading",
      "label": "Heading",
      "default": "Complete your setup"
    },
    {
      "type": "text",
      "id": "offers_text",
      "label": "Text"
    },
    {
      "type": "textarea",
      "id": "single_desc",
      "label": "Single description",
      "default": "The original. Suction-mounts to any bass or guitar in seconds, no instrument modification required."
    },
    {
      "type": "textarea",
      "id": "combo_desc",
      "label": "Combo description",
      "default": "One of each version, so you can find your favorite before committing to one."
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Combo savings tag",
      "info": "Leave empty to calculate it from live prices."
    },
    {
      "type": "textarea",
      "id": "addon_desc",
      "label": "Add-on description",
      "default": "For satin or matte-finish basses — gives the suction cup a surface to grip. Often added with any color."
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "learn_label",
      "label": "Product page link label",
      "default": "Learn more"
    },
    {
      "type": "header",
      "content": "How it works"
    },
    {
      "type": "text",
      "id": "how_heading",
      "label": "Heading",
      "default": "Three steps, no tools"
    },
    {
      "type": "text",
      "id": "how_text",
      "label": "Text",
      "default": "Most thumb rests mean drilling into your instrument. Thumb Fin doesn't."
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Show demo video",
      "default": true
    },
    {
      "type": "video_url",
      "id": "video",
      "accept": ["youtube", "vimeo"],
      "label": "Demo video",
      "info": "Leave empty to use the existing demo (youtube.com/watch?v=Y_QRGtpZdyI)."
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video cover image"
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Heading",
      "default": "See it mounted on a real bass"
    },
    {
      "type": "textarea",
      "id": "video_text",
      "label": "Text",
      "default": "Watch the two-minute demo — attaching, repositioning, and a full playing session with Thumb Fin."
    },
    {
      "type": "text",
      "id": "video_button_label",
      "label": "Button label",
      "default": "Watch demo"
    }
  ],
  "blocks": [
    {
      "type": "ticker",
      "name": "Trust strip item",
      "settings": [
        {
          "type": "text",
          "id": "highlight",
          "label": "Highlighted text",
          "default": "Zero-damage"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "suction mount"
        }
      ]
    },
    {
      "type": "step",
      "name": "How-it-works step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Clean the surface"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Wipe the spot and the suction cup with a soft cloth. Matte finish? Apply the contact paper first."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thumb Fin product extras",
      "blocks": [
        { "type": "ticker", "settings": { "highlight": "Zero-damage", "text": "suction mount" } },
        { "type": "ticker", "settings": { "highlight": "Repositionable", "text": "anytime" } },
        { "type": "ticker", "settings": { "highlight": "6 colors", "text": "one fit" } },
        { "type": "ticker", "settings": { "highlight": "Patented", "text": "since day one" } },
        { "type": "step", "settings": { "heading": "Clean the surface", "text": "Wipe the spot and the suction cup with a soft cloth. Matte finish? Apply the contact paper first." } },
        { "type": "step", "settings": { "heading": "Press it on", "text": "Place it where your thumb naturally rests and press firmly. Move it anytime: no screws, no adhesive." } },
        { "type": "step", "settings": { "heading": "Play, relaxed", "text": "A biomechanically neutral thumb position means less tendon strain, longer sets." } }
      ]
    }
  ]
}
{% endschema %}
