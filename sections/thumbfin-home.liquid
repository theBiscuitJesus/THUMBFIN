{%- comment -%}
  Thumb Fin homepage redesign, ported from docs/thumbfin-redesign.html.

  Styles and scripts live in assets/thumbfin.css and assets/thumbfin.js, shared with
  the product-page and cart sections.

  Built for Dawn 12: add-to-cart goes through Dawn's <product-form> element, so the
  theme's cart notification / drawer opens exactly as on product pages.

  The theme's own header and footer are kept; this section replaces the body
  of the homepage only (hero -> ticker -> how it works -> shop -> reviews -> video).
{%- endcomment -%}

{%- liquid
  assign main = section.settings.product

  assign combo = section.settings.combo_product
  if combo == blank
    assign combo = all_products['combo-3-pack-one-of-each-version']
  endif

  assign addon = section.settings.addon_product
  if addon == blank
    assign addon = all_products['contact-paper-for-matte-finish']
  endif

  assign rating = section.settings.rating
  assign rating_count = section.settings.rating_count
  if section.settings.use_review_metafields and main.metafields.reviews.rating.value != blank
    assign rating = main.metafields.reviews.rating.value.rating | round: 2
    assign rating_count = main.metafields.reviews.rating_count.value
  endif

  assign swatch_lines = section.settings.swatch_colors | newline_to_br | split: '<br />'
-%}

{{ 'thumbfin.css' | asset_url | stylesheet_tag }}


<div class="tfr">
  {%- comment -%} HERO {%- endcomment -%}
  <section class="tfr-hero">
    <div class="tfr-wrap tfr-hero-grid">
      <div>
        {%- if rating != blank -%}
          <p class="tfr-badge">
            <span aria-hidden="true">★</span>
            <b>{{ rating }}</b>
            {%- if rating_count != blank %} from {{ rating_count }} {{ section.settings.rating_suffix | escape }}{% endif -%}
            {%- if section.settings.badge_extra != blank %} · {{ section.settings.badge_extra | escape }}{% endif -%}
          </p>
        {%- endif -%}
        <h1>{{ section.settings.hero_heading | escape | newline_to_br }}</h1>
        {%- if section.settings.hero_text != blank -%}
          <p class="tfr-hero-sub">{{ section.settings.hero_text | escape }}</p>
        {%- endif -%}
        <div class="tfr-cta-row">
          <a class="tfr-btn tfr-btn--primary" href="#thumbfin-shop">
            {{- section.settings.hero_cta_label | escape -}}
            {%- if section.settings.hero_show_price and main != blank %} — {{ main.price | money_without_trailing_zeros }}{% endif -%}
          </a>
          {%- if section.settings.hero_secondary_label != blank -%}
            <a class="tfr-btn tfr-btn--ghost" href="#thumbfin-video">{{ section.settings.hero_secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
      <div class="tfr-hero-art">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 750, 1000', sizes: '(max-width: 820px) 90vw, 480px' }}
        {%- else -%}
          <div class="tfr-fin-disc" aria-hidden="true"><div class="tfr-fin-stem"></div></div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- liquid
    assign ticker_blocks = section.blocks | where: 'type', 'ticker'
    assign step_blocks = section.blocks | where: 'type', 'step'
  -%}
  {%- render 'thumbfin-ticker', blocks: ticker_blocks -%}
  {%- render 'thumbfin-steps', blocks: step_blocks, heading: section.settings.how_heading, text: section.settings.how_text, anchor: 'thumbfin-how' -%}

  {%- comment -%} SHOP: single product spotlight + bundle row {%- endcomment -%}
  <section class="tfr-section" id="thumbfin-shop">
    <div class="tfr-wrap">
      {%- if main != blank -%}
        {%- liquid
          assign current = main.selected_or_first_available_variant
          assign first_option = main.options.first | downcase
          assign use_swatches = false
          if main.options.size == 1 and main.has_only_default_variant == false
            if first_option == 'color' or first_option == 'colour'
              assign use_swatches = true
            endif
          endif
          assign current_media = current.featured_media | default: main.featured_media
        -%}
        <thumbfin-spotlight class="tfr-spotlight">
          <div class="tfr-spot-visual">
            {%- if current_media != blank -%}
              {{ current_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', sizes: '(max-width: 820px) 90vw, 440px', alt: main.title, class: 'tfr-spot-img' }}
            {%- else -%}
              <div class="tfr-fin-disc" aria-hidden="true"><div class="tfr-fin-stem"></div></div>
            {%- endif -%}
          </div>
          <div>
            <h2 class="tfr-eyebrow">{{ main.title | escape }}</h2>
            <div class="tfr-price-row">
              <span class="tfr-price" data-tfr-price>{{ current.price | money_without_trailing_zeros }}</span>
              <s class="tfr-compare" data-tfr-compare>{% if current.compare_at_price > current.price %}{{ current.compare_at_price | money_without_trailing_zeros }}{% endif %}</s>
              {%- if section.settings.price_note != blank -%}
                <span class="tfr-price-note">{{ section.settings.price_note | escape }}</span>
              {%- endif -%}
            </div>
            <p class="tfr-desc">
              {%- if section.settings.spotlight_desc != blank -%}
                {{ section.settings.spotlight_desc | escape }}
              {%- else -%}
                {{ main.description | strip_html | truncatewords: 30 }}
              {%- endif -%}
            </p>

            <product-form class="tfr-product-form" data-hide-errors="false">
            {%- form 'product', main, novalidate: 'novalidate' -%}
              {%- if main.has_only_default_variant or use_swatches -%}
                <input type="hidden" name="id" value="{{ current.id }}" data-tfr-variant-id>
              {%- endif -%}
              {%- if use_swatches -%}
                <fieldset class="tfr-swatches">
                  <legend class="tfr-option-label">{{ main.options.first | escape }}: <span data-tfr-variant-title>{{ current.title | escape }}</span></legend>
                  <div class="tfr-swatch-row">
                    {%- for variant in main.variants -%}
                      {%- liquid
                        assign swatch = false
                        for value in main.options_with_values.first.values
                          if value.name == variant.option1 and value.swatch.color != blank
                            assign swatch = value.swatch.color
                          endif
                        endfor
                        if swatch == false
                          assign variant_key = variant.option1 | handleize
                          for line in swatch_lines
                            assign pair = line | split: ':'
                            assign pair_key = pair.first | strip | handleize
                            if pair_key == variant_key
                              assign swatch = pair.last | strip
                            endif
                          endfor
                        endif
                      -%}
                      <input
                        type="radio"
                        class="tfr-visually-hidden"
                        id="tfr-{{ section.id }}-{{ variant.id }}"
                        name="tfr-variant-{{ section.id }}"
                        value="{{ variant.id }}"
                        data-tfr-variant-input
                        {% if variant.id == current.id %}checked{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                        data-price="{{ variant.price | money_without_trailing_zeros | escape }}"
                        data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_without_trailing_zeros | escape }}{% endif %}"
                        data-available="{{ variant.available }}"
                        data-title="{{ variant.title | escape }}"
                        data-image="{% if variant.featured_media %}{{ variant.featured_media.preview_image | image_url: width: 900 }}{% endif %}"
                      >
                      <label
                        for="tfr-{{ section.id }}-{{ variant.id }}"
                        class="tfr-swatch"
                        title="{{ variant.title | escape }}"
                        {% if swatch %}style="--tfr-swatch: {{ swatch }};"{% endif %}
                      >
                        <span class="tfr-visually-hidden">{{ variant.title | escape }}{% unless variant.available %} (sold out){% endunless %}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- elsif main.has_only_default_variant == false -%}
                <label class="tfr-option-label" for="tfr-{{ section.id }}-variant">{{ main.options | join: ' / ' | escape }}</label>
                <select class="tfr-select" id="tfr-{{ section.id }}-variant" name="id" data-tfr-variant-input>
                  {%- for variant in main.variants -%}
                    <option
                      value="{{ variant.id }}"
                      {% if variant.id == current.id %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                      data-price="{{ variant.price | money_without_trailing_zeros | escape }}"
                      data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_without_trailing_zeros | escape }}{% endif %}"
                      data-available="{{ variant.available }}"
                      data-title="{{ variant.title | escape }}"
                      data-image="{% if variant.featured_media %}{{ variant.featured_media.preview_image | image_url: width: 900 }}{% endif %}"
                    >
                      {{- variant.title | escape }}{% unless variant.available %} (sold out){% endunless -%}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
              <button
                type="submit"
                name="add"
                class="tfr-btn tfr-btn--primary"
                data-tfr-submit
                data-label-add="{{ section.settings.add_label | escape }}"
                data-label-sold-out="Sold out"
                {% unless current.available %}disabled{% endunless %}
              >
                <span data-tfr-submit-label>
                  {%- if current.available -%}{{ section.settings.add_label | escape }}{%- else -%}Sold out{%- endif -%}
                </span>
                {%- render 'loading-spinner' -%}
              </button>
              <div class="product-form__error-message-wrapper tfr-form-error" role="alert" hidden>
                <span class="product-form__error-message"></span>
              </div>
            {%- endform -%}
            </product-form>
          </div>
        </thumbfin-spotlight>
      {%- elsif request.design_mode -%}
        <p class="tfr-editor-note">Choose the single Thumb Fin product under “Products” in this section’s settings.</p>
      {%- endif -%}

      {%- if combo.id != blank or addon.id != blank -%}
        {%- liquid
          assign singles_total = nil
          if main != blank
            assign singles_total = main.price | times: section.settings.combo_units
          endif
        -%}
        <div class="tfr-bundle-row">
          {%- if combo.id != blank -%}
            {%- render 'thumbfin-offer-card',
              product: combo,
              featured: true,
              description: section.settings.combo_desc,
              singles_total: singles_total,
              units: section.settings.combo_units,
              save_label: section.settings.save_label,
              add_label: section.settings.add_label,
              uid: section.id
            -%}
          {%- endif -%}
          {%- if addon.id != blank -%}
            {%- render 'thumbfin-offer-card',
              product: addon,
              prefix: '+ ',
              description: section.settings.addon_desc,
              add_label: section.settings.add_label,
              uid: section.id
            -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} REVIEWS {%- endcomment -%}
  {%- assign quote_blocks = section.blocks | where: 'type', 'quote' -%}
  {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
  {%- if quote_blocks.size > 0 or app_blocks.size > 0 -%}
    <section class="tfr-section" id="thumbfin-reviews">
      <div class="tfr-wrap">
        <div class="tfr-section-head">
          <h2>{{ section.settings.reviews_heading | escape }}</h2>
          {%- if section.settings.reviews_text != blank -%}<p>{{ section.settings.reviews_text | escape }}</p>{%- endif -%}
        </div>
        {%- if quote_blocks.size > 0 -%}
          <div class="tfr-quotes">
            {%- for block in quote_blocks -%}
              <blockquote class="tfr-quote" {{ block.shopify_attributes }}>
                <p>{{ block.settings.text | escape }}</p>
                {%- if block.settings.author != blank -%}<cite>— {{ block.settings.author | escape }}</cite>{%- endif -%}
              </blockquote>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if app_blocks.size > 0 -%}
          <div class="tfr-app-blocks">
            {%- for block in app_blocks -%}
              {% render block %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- render 'thumbfin-video',
    video: section.settings.video,
    poster: section.settings.video_poster,
    heading: section.settings.video_heading,
    text: section.settings.video_text,
    button_label: section.settings.video_button_label,
    anchor: 'thumbfin-video'
  -%}
</div>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'thumbfin.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Thumb Fin homepage",
  "tag": "div",
  "class": "section-thumbfin-home",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Single Thumb Fin",
      "info": "Colour swatches are built from this product's variants."
    },
    {
      "type": "product",
      "id": "combo_product",
      "label": "Combo pack",
      "info": "Falls back to the product with handle combo-3-pack-one-of-each-version."
    },
    {
      "type": "range",
      "id": "combo_units",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Singles included in combo",
      "info": "Used to calculate the savings tag (singles × price − combo price)."
    },
    {
      "type": "product",
      "id": "addon_product",
      "label": "Add-on (contact paper)",
      "info": "Falls back to the product with handle contact-paper-for-matte-finish."
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "textarea",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Stop drilling holes\nin your bass."
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Text",
      "default": "Thumb Fin is a suction-cup thumb rest you can place anywhere, move anytime, and remove without a trace. No screws, no adhesive, no regrets."
    },
    {
      "type": "text",
      "id": "hero_cta_label",
      "label": "Main button label",
      "default": "Shop Thumb Fin"
    },
    {
      "type": "checkbox",
      "id": "hero_show_price",
      "label": "Show single price on main button",
      "default": true
    },
    {
      "type": "text",
      "id": "hero_secondary_label",
      "label": "Video button label",
      "default": "Watch it in action"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Leave empty to show the drawn Thumb Fin graphic."
    },
    {
      "type": "header",
      "content": "Rating badge"
    },
    {
      "type": "checkbox",
      "id": "use_review_metafields",
      "label": "Use live rating from review app",
      "info": "Reads the standard reviews.rating / reviews.rating_count product metafields (Judge.me, Yotpo, Shopify Product Reviews, etc.). Falls back to the values below.",
      "default": true
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.84"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Review count",
      "default": "145"
    },
    {
      "type": "text",
      "id": "rating_suffix",
      "label": "Reviewer noun",
      "default": "bassists"
    },
    {
      "type": "text",
      "id": "badge_extra",
      "label": "Extra badge text",
      "default": "Patented design"
    },
    {
      "type": "header",
      "content": "How it works"
    },
    {
      "type": "text",
      "id": "how_heading",
      "label": "Heading",
      "default": "Three steps, no tools"
    },
    {
      "type": "text",
      "id": "how_text",
      "label": "Text",
      "default": "Most thumb rests mean drilling into your instrument. Thumb Fin doesn't."
    },
    {
      "type": "header",
      "content": "Shop"
    },
    {
      "type": "textarea",
      "id": "spotlight_desc",
      "label": "Single product description",
      "info": "Leave empty to use the product's own description.",
      "default": "The original. Suction-mounts to any bass or guitar in seconds, no instrument modification required."
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "free US shipping over $35"
    },
    {
      "type": "textarea",
      "id": "swatch_colors",
      "label": "Swatch colours",
      "info": "One per line as Colour name: #hex. Only used where the variant has no colour swatch set in Shopify.",
      "default": "Black: #171717\nNeon: #c3ff5c\nRed: #c23b3b\nSky Blue: #5fb8e0\nYellow: #e8c93f\nPink: #e07bb0"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "textarea",
      "id": "combo_desc",
      "label": "Combo description",
      "default": "One of each version, so you can find your favorite before committing to one."
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Combo savings tag",
      "info": "Leave empty to calculate it from live prices."
    },
    {
      "type": "textarea",
      "id": "addon_desc",
      "label": "Add-on description",
      "default": "For satin or matte-finish basses — gives the suction cup a surface to grip. Often added with any color."
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Heading",
      "default": "What bassists are saying"
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Text",
      "default": "145 reviews, 89% five-star."
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video_url",
      "id": "video",
      "accept": ["youtube", "vimeo"],
      "label": "Demo video",
      "info": "Leave empty to use the existing demo (youtube.com/watch?v=Y_QRGtpZdyI)."
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video cover image",
      "info": "Optional. YouTube videos use their own thumbnail by default."
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Heading",
      "default": "See it mounted on a real bass"
    },
    {
      "type": "textarea",
      "id": "video_text",
      "label": "Text",
      "default": "Watch the two-minute demo — attaching, repositioning, and a full playing session with Thumb Fin."
    },
    {
      "type": "text",
      "id": "video_button_label",
      "label": "Button label",
      "default": "Watch demo"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "ticker",
      "name": "Trust strip item",
      "settings": [
        {
          "type": "text",
          "id": "highlight",
          "label": "Highlighted text",
          "default": "Zero-damage"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "suction mount"
        }
      ]
    },
    {
      "type": "step",
      "name": "How-it-works step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Press it on"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "The suction cup grips any gloss or satin finish — no adhesive residue, ever."
        }
      ]
    },
    {
      "type": "quote",
      "name": "Review quote",
      "settings": [
        {
          "type": "paragraph",
          "content": "Use the customer's exact review text, with their permission."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thumb Fin homepage",
      "blocks": [
        { "type": "ticker", "settings": { "highlight": "Zero-damage", "text": "suction mount" } },
        { "type": "ticker", "settings": { "highlight": "Repositionable", "text": "anytime" } },
        { "type": "ticker", "settings": { "highlight": "6 colors", "text": "one fit" } },
        { "type": "ticker", "settings": { "highlight": "Patented", "text": "since day one" } },
        { "type": "step", "settings": { "heading": "Press it on", "text": "The suction cup grips any gloss or satin finish — no adhesive residue, ever." } },
        { "type": "step", "settings": { "heading": "Place it right", "text": "Slide it into your exact hand position, above or below the strings." } },
        { "type": "step", "settings": { "heading": "Play, relaxed", "text": "A biomechanically neutral thumb position means less tendon strain, longer sets." } },
        { "type": "quote", "settings": { "text": "Stays locked in through full sets, and it finally gives my thumb a proper resting spot without touching my instrument.", "author": "Flavio P., Italy" } },
        { "type": "quote", "settings": { "text": "Didn't want to drill into my Stingray, so this was the only real option — and it genuinely doesn't slide around.", "author": "Anna A." } },
        { "type": "quote", "settings": { "text": "Keeps my thumb off the E string so my fingers can actually focus on plucking. Simple fix, big difference.", "author": "David M." } }
      ]
    }
  ]
}
{% endschema %}
