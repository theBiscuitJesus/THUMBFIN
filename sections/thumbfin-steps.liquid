{%- comment -%}
  Thumb Fin redesign: "Three steps, no tools".
{%- endcomment -%}
{{ 'thumbfin.css' | asset_url | stylesheet_tag }}
{%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
<div class="tfr">
  {%- render 'thumbfin-steps', blocks: step_blocks, heading: section.settings.heading, text: section.settings.text, anchor: 'thumbfin-how' -%}
</div>

{% schema %}
{
  "name": "Thumb Fin steps",
  "tag": "div",
  "class": "section-thumbfin-steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps, no tools" },
    { "type": "text", "id": "text", "label": "Text", "default": "Most thumb rests mean drilling into your instrument. Thumb Fin doesn't." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Clean the surface" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wipe the spot and the suction cup with a soft cloth. Matte finish? Apply the contact paper first." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thumb Fin steps",
      "blocks": [
        { "type": "step", "settings": { "heading": "Clean the surface", "text": "Wipe the spot and the suction cup with a soft cloth. Matte finish? Apply the contact paper first." } },
        { "type": "step", "settings": { "heading": "Press it on", "text": "Place it where your thumb naturally rests and press firmly. Move it anytime: no screws, no adhesive." } },
        { "type": "step", "settings": { "heading": "Play, relaxed", "text": "Your thumb rests in a relaxed, natural position, so you can focus on your playing, not your hand." } }
      ]
    }
  ]
}
{% endschema %}
